{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "stack (docker compose up)",
      "runtimeExecutable": "docker",
      "runtimeArgs": [
        "compose",
        "-f",
        "infra/compose/docker-compose.yml",
        "up"
      ],
      "port": 3000,
      "autoPort": false
    },
    {
      "name": "api (uvicorn, host)",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--package",
        "asor-api",
        "uvicorn",
        "asor_api.app:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8000",
        "--reload"
      ],
      "port": 8000,
      "autoPort": false
    },
    {
      "name": "web (next dev, host via bun)",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["--bun", "next", "dev", "--cwd", "apps/web"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "postgres (docker)",
      "runtimeExecutable": "docker",
      "runtimeArgs": [
        "compose",
        "-f",
        "infra/compose/docker-compose.yml",
        "up",
        "postgres"
      ],
      "port": 5432,
      "autoPort": false
    }
  ]
}
