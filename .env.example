# --- Google Cloud / Vertex AI auth ---
# We authenticate via Application Default Credentials (ADC), not an API key.
# Run `gcloud auth application-default login` on the host before starting the stack.
# IMPORTANT: do NOT set GEMINI_API_KEY or GOOGLE_API_KEY — they take precedence
# over ADC and will break the auth flow inside the runner container.

GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=replace-me
GOOGLE_CLOUD_LOCATION=global

# Default Gemini model used by sub-agents unless overridden per task.
# Examples: a stable alias (flash, pro, flash-lite) or a fully-qualified model id.
GEMINI_MODEL=gemini-3.1-flash-lite-preview

# Absolute host path to your ADC credentials file. Default macOS/Linux path shown.
# This file is mounted read-only into each runner container.
ASOR_GCLOUD_ADC_PATH=${HOME}/.config/gcloud/application_default_credentials.json

# --- asor internal ---
DATABASE_URL=postgresql+psycopg://asor:asor@postgres:5432/asor
ASOR_API_BASE_URL=http://api:8000
ASOR_AGENT_RUNNER_IMAGE=asor-agent-runner:dev
